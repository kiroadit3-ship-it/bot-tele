# =========================
# TELEGRAM
# =========================
BOT_TOKEN=tokenbotanda
ADMIN_IDS=idadmin1,idadmin2

# =========================
# PAKASIR
# Buat project di Pakasir, ambil Slug dan API Key.
# Gunakan hanya QRIS: API method transactioncreate/qris.
# =========================
PAKASIR_PROJECT=slugprojectanda
PAKASIR_API_KEY=apikeyanda

# Wajib jika menggunakan webhook Pakasir.
# Set di dashboard Pakasir: https://domainanda.com/pakasir/webhook
PUBLIC_BASE_URL=https://overpainfully-lunisolar-marlys.ngrok-free.dev

# =========================
# SERVER
# =========================
PORT=3000
DB_PATH=./data/store.sqlite

# Dalam menit. Sesuaikan dengan expired_at dari Pakasir atau kebutuhan toko.
ORDER_EXPIRE_MINUTES=30

# true = bot juga cek status transaksi berkala via Transaction Detail API.
# Disarankan true sebagai backup selain webhook.
ENABLE_STATUS_POLLING=true
STATUS_POLLING_CRON=*/1 * * * *

# Mata uang tampilan
CURRENCY_PREFIX=Rp
